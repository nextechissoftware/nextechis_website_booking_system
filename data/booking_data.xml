<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_booking_order" model="ir.sequence">
        <field name="name">Booking Order</field>
        <field name="code">booking.order</field>
        <field name="prefix">BK/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Default time slots, edit or archive them in Configuration > Time Slots -->
    <record id="booking_time_slot_0900" model="booking.time.slot">
        <field name="sequence">10</field>
        <field name="start_time">9.0</field>
        <field name="end_time">11.0</field>
    </record>
    <record id="booking_time_slot_1200" model="booking.time.slot">
        <field name="sequence">20</field>
        <field name="start_time">12.0</field>
        <field name="end_time">14.0</field>
    </record>
    <record id="booking_time_slot_1500" model="booking.time.slot">
        <field name="sequence">30</field>
        <field name="start_time">15.0</field>
        <field name="end_time">17.0</field>
    </record>
    <record id="booking_time_slot_1800" model="booking.time.slot">
        <field name="sequence">40</field>
        <field name="start_time">18.0</field>
        <field name="end_time">20.0</field>
    </record>
    <record id="booking_time_slot_2100" model="booking.time.slot">
        <field name="sequence">50</field>
        <field name="start_time">21.0</field>
        <field name="end_time">23.0</field>
    </record>
</odoo>
