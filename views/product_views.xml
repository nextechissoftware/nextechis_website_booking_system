<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_booking" model="ir.ui.view">
        <field name="name">product.template.form.booking</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_check_booking_quantity" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        invisible="not is_booking_product or not id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Check Booking Quantity</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_booking_product"/>
                    <label for="is_booking_product"/>
                </span>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Booking &amp; Reservation" name="booking_reservation"
                      invisible="not is_booking_product">
                    <group>
                        <group name="booking_from">
                            <field name="booking_start_date"/>
                            <field name="booking_limit_advance"/>
                            <label for="booking_advance_days" invisible="not booking_limit_advance"/>
                            <div invisible="not booking_limit_advance" class="o_row">
                                <field name="booking_advance_days" required="booking_limit_advance"/>
                                <span>Days</span>
                            </div>
                        </group>
                        <group name="booking_to">
                            <field name="booking_end_date"/>
                            <field name="booking_closing_period_ids" widget="many2many_tags"
                                   options="{'no_quick_create': True}"/>
                            <field name="booking_max_qty"/>
                        </group>
                    </group>
                    <separator string="Plans &amp; Prices"/>
                    <field name="booking_plan_line_ids">
                        <list editable="bottom">
                            <field name="plan_id"/>
                            <field name="price"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <separator string="Configure Day Slots"/>
                    <field name="booking_day_slot_ids">
                        <list editable="bottom">
                            <field name="day"/>
                            <field name="time_slot_ids" widget="many2many_tags"
                                   placeholder="All time slots"/>
                            <field name="status"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        Only the weekdays listed above are bookable, any other weekday is shown
                        as Closed. Leave Time Slots empty to offer all time slots on that day.
                    </p>
                </page>
            </xpath>
        </field>
    </record>

    <record id="booking_product_action" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_booking_product', '=', True)]</field>
        <field name="context">{'default_is_booking_product': True, 'default_type': 'service', 'default_sale_ok': True, 'default_purchase_ok': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a booking product</p>
            <p>Any product can be a booking product: a court, a room, a tour, a movie show...</p>
        </field>
    </record>
</odoo>
