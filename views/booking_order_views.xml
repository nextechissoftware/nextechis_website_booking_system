<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="booking_order_view_list" model="ir.ui.view">
        <field name="name">booking.order.list</field>
        <field name="model">booking.order</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'done'" decoration-muted="state == 'cancelled'" create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="plan_id"/>
                <field name="booking_date"/>
                <field name="time_slot_id"/>
                <field name="quantity"/>
                <field name="amount"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"
                       decoration-info="state == 'confirmed'" decoration-danger="state == 'cancelled'"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="booking_order_view_form" model="ir.ui.view">
        <field name="name">booking.order.form</field>
        <field name="model">booking.order</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_done" type="object" string="Mark as Done"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel Booking"
                            invisible="state == 'cancelled'"
                            confirm="Cancelling releases the booked quantity on the date and time slot. Continue?"/>
                    <button name="action_reset" type="object" string="Set to Confirmed"
                            invisible="state == 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Sale Order</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group name="customer">
                            <field name="partner_id"/>
                            <field name="sale_order_id"/>
                            <field name="sale_state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="booking">
                            <field name="product_tmpl_id"/>
                            <field name="plan_id"/>
                            <field name="booking_date"/>
                            <field name="time_slot_id"/>
                            <field name="quantity"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="True"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="booking_order_view_search" model="ir.ui.view">
        <field name="name">booking.order.search</field>
        <field name="model">booking.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="plan_id"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="group_booking_date" string="Booking Date" context="{'group_by': 'booking_date:day'}"/>
                    <filter name="group_time_slot" string="Time Slot" context="{'group_by': 'time_slot_id'}"/>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="booking_order_action" model="ir.actions.act_window">
        <field name="name">Booking Orders</field>
        <field name="res_model">booking.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No booking yet</p>
            <p>Booking orders are created automatically when a customer's order is confirmed.</p>
        </field>
    </record>

    <record id="booking_order_view_pivot" model="ir.ui.view">
        <field name="name">booking.order.pivot</field>
        <field name="model">booking.order</field>
        <field name="arch" type="xml">
            <pivot string="Bookings">
                <field name="booking_date" type="row" interval="day"/>
                <field name="time_slot_id" type="row"/>
                <field name="plan_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="booking_order_view_graph" model="ir.ui.view">
        <field name="name">booking.order.graph</field>
        <field name="model">booking.order</field>
        <field name="arch" type="xml">
            <graph string="Bookings" type="bar">
                <field name="booking_date" interval="day"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="booking_report_action" model="ir.actions.act_window">
        <field name="name">Booking Report</field>
        <field name="res_model">booking.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', '!=', 'cancelled')]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
