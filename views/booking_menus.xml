<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_booking_root" name="Bookings" sequence="60"
              web_icon="nextechis_website_booking_system,static/description/icon.png"
              groups="base.group_user"/>
    <menuitem id="menu_booking_orders" name="Booking Orders" parent="menu_booking_root"
              action="booking_order_action" sequence="10"/>
    <menuitem id="menu_booking_report" name="Reporting" parent="menu_booking_root"
              action="booking_report_action" sequence="15"/>
    <menuitem id="menu_booking_products" name="Products" parent="menu_booking_root"
              action="booking_product_action" sequence="20"/>
    <menuitem id="menu_booking_config" name="Configuration" parent="menu_booking_root"
              sequence="90" groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_booking_plans" name="Plans" parent="menu_booking_config"
              action="booking_plan_action" sequence="10"/>
    <menuitem id="menu_booking_time_slots" name="Time Slots" parent="menu_booking_config"
              action="booking_time_slot_action" sequence="20"/>
    <menuitem id="menu_booking_closing_periods" name="Closing Periods" parent="menu_booking_config"
              action="booking_closing_period_action" sequence="30"/>

    <record id="website_menu_booking" model="website.menu">
        <field name="name">Booking</field>
        <field name="url">/booking</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="55"/>
    </record>
</odoo>
