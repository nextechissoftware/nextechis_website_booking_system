<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="booking_closing_period_view_list" model="ir.ui.view">
        <field name="name">booking.closing.period.list</field>
        <field name="model">booking.closing.period</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>

    <record id="booking_closing_period_view_form" model="ir.ui.view">
        <field name="name">booking.closing.period.form</field>
        <field name="model">booking.closing.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="booking_closing_period_action" model="ir.actions.act_window">
        <field name="name">Closing Periods</field>
        <field name="res_model">booking.closing.period</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a closing period</p>
            <p>Date ranges (holidays, maintenance...) that you can attach to any product so it cannot be booked on those dates.</p>
        </field>
    </record>
</odoo>
